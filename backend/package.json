"scripts": {
  "dev": "nodemon --exec ts-node src/server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/server.js",
  "lint": "eslint . --ext .ts",
  "test": "jest --runInBand",
  "migrate:up": "node -r dotenv/config node_modules/.bin/node-pg-migrate up -m src/database/migrations",
  "migrate:down": "node -r dotenv/config node_modules/.bin/node-pg-migrate down -m src/database/migrations",
  "migrate:create": "node-pg-migrate create -m src/database/migrations",
  "seed": "node -r dotenv/config node_modules/.bin/ts-node src/database/seeds/seed.ts"
}